[nemesis]
version=1.1
id=plex.geekd4dlabs.compat-test
name=PLEX COMPAT TEST (GUARDED)
type=application,service
package-version=0.1.0
short-desc=Plex compatibility test, blocked unless the car is confirmed parked.
detailed-desc=Installs Plex with GET_TASKS, current CA, and fullscreen compatibility changes plus the mandatory standalone Park Guard. No HMG-API dependency.
os=any
models=any
preinstall=scripts/pre.sh
preuninstall=guard/preuninstall.sh

[app.0]
kind=apk
path=app/Plex.apk
package=com.plexapp.android
component=com.plexapp.android/com.plexapp.plex.activities.SplashActivity

[service.0]
name=plex-compat-test-guard
kind=sh
path=guard/safeplex-guard.sh
uid=root
mode=restart
