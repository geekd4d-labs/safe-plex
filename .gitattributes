# Device-facing and build-input files must keep LF endings everywhere:
# CRLF breaks /system/bin/sh scripts and the NEMESIS descriptor on the
# head unit, and changes the deterministic package bytes.
*.sh text eol=lf
*.data text eol=lf
*.py text eol=lf
*.java text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.apk binary
