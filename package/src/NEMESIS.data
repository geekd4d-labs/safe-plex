[nemesis]
version=1.1
id=plex.geekd4dlabs.safe
name=SAFE PLEX
types=application,service
package-version=1.1.0
short-desc=Plex for the EV6; blocked unless confirmed parked.
detailed-desc=Installs the EV6 Plex build plus a root guard service that force-stops Plex unless factory vehicle services confirm the car is in Park, stopped, and unrestricted. No HMG-API dependency.
os=any
models=any
preinstall=scripts/pre.sh
preuninstall=guard/preuninstall.sh

[app.0]
kind=apk
path=app/Plex.apk
package=com.plexapp.android
component=com.plexapp.android/com.plexapp.plex.activities.SplashActivity

[service.0]
name=safe-plex-guard
kind=sh
path=guard/safeplex-guard.sh
uid=root
mode=restart
