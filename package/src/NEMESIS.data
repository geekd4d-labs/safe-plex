[nemesis]
version=1.1
id=plex.geekd4dlabs.safe
name=SAFE PLEX
type=application,service
types=application,service
package-version=1.2.1
short-desc=Plex for Kia/Hyundai Gen5W; parked use only.
detailed-desc=Gen5W Plex with a fail-closed Park Guard. Playback requires factory proof of Park, stopped, and unrestricted. EV6-tested 0.1.3 runtime; the 1.2.1 archive is not vehicle-installed. Ioniq 5 support is experimental. Parked use only.
depends=!plex.geekd4dlabs.compat-test
os=CVEV.USA.0000.V015.012.260507
models=cvev_us,neev_us,neev23_us
preinstall=scripts/pre.sh
preuninstall=guard/preuninstall.sh

[app.0]
kind=apk
path=app/Plex.apk
package=com.plexapp.android
component=com.plexapp.android/com.plexapp.plex.activities.SplashActivity

[service.0]
name=safe-plex-guard
kind=sh
path=guard/safeplex-guard.sh
uid=root
mode=restart
