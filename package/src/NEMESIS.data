[nemesis]
version=1.1
id=plex.geekd4dlabs.safe
name=SAFE PLEX
types=application,service
package-version=1.2.0
short-desc=Plex for Kia/Hyundai Gen5W; parked use only.
detailed-desc=Installs the Gen5W Plex build plus a fail-closed root guard that requires factory proof of Park, stopped, and unrestricted. Attempts compatible API 19 Kia/Hyundai Gen5W units. Runtime behavior comes from the EV6-tested 0.1.3 lineage; the 1.2.0 archive has not been vehicle-installed. Ioniq 5 and other vehicles remain experimental.
os=any
models=any
preinstall=scripts/pre.sh
preuninstall=guard/preuninstall.sh

[app.0]
kind=apk
path=app/Plex.apk
package=com.plexapp.android
component=com.plexapp.android/com.plexapp.plex.activities.SplashActivity

[service.0]
name=safe-plex-guard
kind=sh
path=guard/safeplex-guard.sh
uid=root
mode=restart
